views 'Security' {

  // ═══════════════════════════════════════════════════
  //  Network Isolation — Before Lockdown
  // ═══════════════════════════════════════════════════
  view network_before_lockdown {
    title 'Security / Network Isolation — Before Lockdown (Provisioning)'
    description '''
**SG Phase 1** — `lockdown_enabled = false`.

Operator reachable ports (admin CIDR):
- SSH:22 → master + warpgate
- kube-api:6443 → master

Customer reachable ports (0.0.0.0/0):
- 80, 443, 2222 → Caddy (hostPort)

No NetworkPolicy enforcement yet. Cilium eBPF mesh: all node-to-node open.
'''

    include
      customer,
      operator,
      k8s_platform.sg

    include
      customer -> k8s_platform.caddy with {
        title 'HTTPS:443 + HTTP:80'
      }

    include
      operator -> k8s_platform.caddy with {
        title 'SSH:22 (admin CIDR)'
      }
    include
      operator -> k8s_platform.control_plane with {
        title 'kube-api:6443'
      }
    include
      operator -> k8s_platform.warpgate with {
        title 'SSH:22 (admin CIDR)'
      }

    autoLayout LeftRight 150 100

    style k8s_platform.sg { color bank_green }
    style k8s_platform.caddy { color sky }
    style k8s_platform.warpgate { color bank_red }
    style k8s_platform.control_plane { color primary }
    style customer { color sky }
    style operator { color amber }
  }

  // ═══════════════════════════════════════════════════
  //  Network Isolation — After Lockdown
  // ═══════════════════════════════════════════════════
  view network_after_lockdown {
    title 'Security / Network Isolation — After Lockdown (Operational)'
    description '''
**SG Phase 2** — `lockdown_enabled = true`.

Only 3 ports open from anywhere:
- 80/443 → Caddy (app traffic)
- 2222 → Warpgate SSH proxy

SSH:22 and kube-api:6443 — BLOCKED to all nodes.
Warpgate is the sole management path. NetworkPolicies: default-deny + 7 allow-lists.
Cilium eBPF mesh: node-to-node internal traffic still unrestricted.
'''

    include
      customer,
      operator,
      k8s_platform.sg,
      k8s_platform.netpol,
      k8s_platform.control_plane

    include
      customer -> k8s_platform.caddy with {
        title 'HTTPS:443 + HTTP:80'
      }

    include
      operator -> k8s_platform.warpgate with {
        title 'ssh -p 2222 (sole path)'
      }

    autoLayout LeftRight 150 100

    style k8s_platform.sg { color bank_red }
    style k8s_platform.caddy { color sky }
    style k8s_platform.warpgate { color bank_red }
    style k8s_platform.netpol { color muted; opacity 40% }
    style k8s_platform.control_plane { color muted; opacity 40% }
    style customer { color sky }
    style operator { color amber }
  }

}
