views 'Architecture' {

  // ═══════════════════════════════════════════════════
  //  Banking Application — Container View
  // ═══════════════════════════════════════════════════
  view banking_system of banking {
    title 'Containers / Banking Application'
    description '''
**13 containers.** Traffic: Caddy(TLS, hostPort) → Kong(ClusterIP) → routes by path:
`/` → frontend, `/api` → api-producer, `/ws` → notification (WebSocket).

Backend services communicate over NATS RPC. PostgreSQL + Redis StatefulSets with PVs.
'''

    autoLayout LeftRight 120 100

    group 'Ingress' {
      color bank_green
      opacity 25%
      border dashed
      include k8s_platform.caddy
    }
    group 'Gateway + Web' {
      color bank_indigo
      opacity 20%
      border dashed
      include kong, frontend
    }
    group 'Bridge' {
      color primary
      opacity 20%
      border dashed
      include producer
    }
    group 'Message Bus' {
      color sky
      opacity 20%
      border dashed
      include nats, jets
    }
    group 'Consumers (Go)' {
      color amber
      opacity 15%
      border dashed
      include auth, account, transfer, notify
    }
    group 'Data' {
      color secondary
      opacity 20%
      border dashed
      include postgres, redis
    }

    global style theme_banking
  }

}
