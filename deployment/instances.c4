deployment {

  // ── Master node — Caddy (hostPort) + ArgoCD ──
  extend aws.vpc.master {
    caddyInstance = instanceOf k8s_platform.caddy {
      title 'Caddy (hostPort 80/443/2222)'
      description 'Pinned via nodeSelector. Handles all external traffic. Reverse-proxies to Kong (app), Warpgate (admin UI + SSH). Holds Let\'s Encrypt certs.'
    }
    argoInstance = instanceOf k8s_platform.argocd {
      title 'ArgoCD Server'
      description 'Watches banking-demo-gitops. Syncs banking + Warpgate Applications. prune + selfHeal, 3-retry backoff.'
    }
  }

  // ── Worker 1 — Entry + messaging ──
  extend aws.vpc.worker1 {
    kongInstance = instanceOf banking.kong {
      title 'Kong :8000 (ClusterIP)'
    }
    frontendInstance = instanceOf banking.frontend {
      title 'Frontend (nginx:alpine)'
    }
    producerInstance = instanceOf banking.producer {
      title 'api-producer ×2'
    }
    natsInstance = instanceOf banking.nats {
      title 'NATS + JetStream (1Gi PVC)'
    }
  }

  // ── Worker 2 — Services + data ──
  extend aws.vpc.worker2 {
    authInstance = instanceOf banking.auth {
      title 'auth-service ×2'
    }
    accountInstance = instanceOf banking.account {
      title 'account-service ×2'
    }
    transferInstance = instanceOf banking.transfer {
      title 'transfer-service ×2'
    }
    notifyInstance = instanceOf banking.notify {
      title 'notification-service ×2'
    }
    postgresInstance = instanceOf banking.postgres {
      title 'PostgreSQL 18 (5Gi PV)'
    }
    redisInstance = instanceOf banking.redis {
      title 'Redis 8 (1Gi PV)'
    }
  }

  // ═══════════════════════════════════════════════════
  //  DEPLOYMENT RELATIONSHIPS
  // ═══════════════════════════════════════════════════

  // ── SG applies to all nodes ──
  aws.vpc.sg -> aws.vpc.master 'applies'
  aws.vpc.sg -> aws.vpc.worker1 'applies'
  aws.vpc.sg -> aws.vpc.worker2 'applies'
  aws.vpc.sg -> aws.vpc.warpgate 'applies'

  // ── Cilium eBPF mesh — all nodes connected ──
  aws.vpc.master -> aws.vpc.worker1 'Cilium eBPF'
  aws.vpc.master -> aws.vpc.worker2 'Cilium eBPF'
  aws.vpc.master -> aws.vpc.warpgate 'Cilium eBPF'
  aws.vpc.worker1 -> aws.vpc.worker2 'Cilium eBPF'
  aws.vpc.worker1 -> aws.vpc.warpgate 'Cilium eBPF'
  aws.vpc.worker2 -> aws.vpc.warpgate 'Cilium eBPF'

  // ── Cross-node app traffic ──
  aws.vpc.master.caddyInstance -> aws.vpc.worker1.kongInstance 'reverse proxy (ClusterIP)'
  aws.vpc.master.caddyInstance -> aws.vpc.warpgate 'Warpgate admin + SSH'
}
