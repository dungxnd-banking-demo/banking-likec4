specification {

  // ── Element kinds with shapes, descriptors, and tag inheritance ──
  element actor {
    style { shape person }
  }
  element person {
    description 'Human interacting with the system.'
    style { shape person; icon bootstrap:person }
  }
  element system {
    description 'A software system — the highest level of abstraction.'
    style { color primary }
  }
  element externalSystem {
    description 'External system owned by a third party or another team. Outside our scope.'
    style { color muted }
  }

  element proxy {
    #stateless
    notation 'Edge Proxy'
    description 'Reverse proxy — TLS termination, routing, hostPort binding.'
    style { icon tech:nginx }
  }
  element webapp {
    #stateless
    notation 'SPA'
    description 'Browser-based single-page application.'
    style { shape browser; icon tech:react }
  }
  element apigateway {
    #stateless
    notation 'API Gateway'
    description 'API Gateway — route matching, plugins, rate limiting.'
    style { icon tech:kong }
  }
  element bridge {
    #stateless
    notation 'Bridge'
    description 'Protocol adapter — maps external requests to internal messaging.'
    style { icon tech:go }
  }
  element service {
    notation 'Service'
    description 'Go microservice — request/reply over NATS, SQL over pgxpool, Redis via go-redis.'
    style { icon tech:go }
  }
  element messagebus {
    #event_driven
    notation 'Msg Bus'
    description 'Message broker with request/reply and durable streams.'
    style { icon tech:nats-icon }
  }
  element eventstore {
    #cqrs #event_driven
    notation 'Event Store'
    description 'Durable event log with pull consumers and deduplication.'
    style { icon tech:nats-icon }
  }
  element db {
    #stateful
    notation 'Database'
    description 'Relational database with persistent volumes.'
    style { icon tech:postgresql; shape storage }
  }
  element kvstore {
    #stateful
    notation 'KV Store'
    description 'In-memory key-value store — cache, sessions, pub/sub.'
    style { icon tech:redis; shape storage }
  }
  element o11y {
    notation 'O11y'
    description 'Observability — metrics, logs, traces, dashboards.'
    style { icon tech:grafana }
  }
  element pipeline {
    notation 'Pipeline'
    description 'CI/CD pipeline — build, scan, test, deploy.'
  }
  element scanner {
    notation 'Scanner'
    description 'Security scanner — SAST, secrets, dependencies, config.'
  }
  element cn {
    notation 'CNI'
    description 'Container network interface — pod networking, service routing.'
  }
  element bastion {
    notation 'Bastion'
    description 'Zero-trust SSH bastion with session recording and audit.'
  }

  // ── Relationship kinds ──
  relationship https {
    line solid;
    color secondary;
    head normal;
    title 'HTTPS'
    description 'HTTP over TLS — browser traffic and service-to-service API calls.'
  }
  relationship nat_rpc {
    line solid;
    color green;
    head diamond;
    title 'NATS RPC'
    description 'NATS Core request/reply with nats/micro queue groups.'
  }
  relationship jetstream_evt {
    line dashed;
    color amber;
    head normal;
    title 'JetStream'
    description 'NATS JetStream durable event stream — 30-day retention with Nats-Msg-Id dedup.'
  }
  relationship websocket_cn {
    line solid;
    color sky;
    head normal;
    title 'WebSocket'
    description 'Persistent WebSocket connection — real-time push notifications.'
  }
  relationship redis_cmd {
    line dashed;
    color red;
    head normal;
    title 'Redis'
    description 'Redis commands — GET, SET, HSET, PUBLISH, pipeline operations.'
  }
  relationship sql_tx {
    line solid;
    color gray;
    head normal;
    title 'SQL'
    description 'PostgreSQL queries and Serializable transactions via pgxpool.'
  }
  relationship gitops {
    line solid;
    color sky;
    head diamond;
    title 'GitOps Sync'
    description 'ArgoCD automated sync — prune + selfHeal from Helm chart.'
  }
  relationship provision {
    line dotted;
    color muted;
    head normal;
    title 'Provision'
    description 'Infrastructure provisioning — Terraform + Ansible playbooks.'
  }
  relationship push_image {
    line dotted;
    color muted;
    head normal;
    title 'Push Image'
    description 'Docker build → push to GHCR, tag bump in gitops repo.'
  }
  relationship oltp_grpc {
    line dotted;
    color gray;
    head normal;
    title 'OTLP/gRPC'
    description 'OpenTelemetry Protocol — traces, metrics via OTLP/gRPC on :4317.'
  }
  relationship acme {
    line dotted;
    color green;
    head normal;
    title 'ACME'
    description 'Let\'s Encrypt ACME HTTP-01 challenge for TLS certificate automation.'
  }
  relationship scan {
    line dotted;
    color amber;
    head normal;
    title 'Scan'
    description 'Security scanning — SAST, secrets, dependencies, misconfigurations.'
  }

  // ── Tags ──
  tag cqrs         { color #1b5e20 }
  tag event_driven { color #0d47a1 }
  tag stateful
  tag stateless
  tag realtime
  tag security

  // ── Deployment node kinds ──
  deploymentNode cloud {
    notation 'Cloud'
    description 'Public cloud provider region.'
  }
  deploymentNode region {
    notation 'Region'
    description 'Geographic region within a cloud provider.'
  }
  deploymentNode vpc {
    notation 'VPC'
    description 'Virtual Private Cloud — isolated network with public subnet.'
  }
  deploymentNode ec2 {
    notation 'EC2'
    technology 'AWS EC2 · Spot'
    description 'Spot EC2 instance running Ubuntu 26.04, part of a K8s cluster.'
  }
  deploymentNode sg {
    notation 'SG'
    description 'AWS Security Group — phased ingress rules (provisioning → lockdown).'
  }

  // ── Colors ──
  color bank_green #2e7d32
  color bank_indigo #283593
  color bank_amber #f57c00
  color bank_red #c62828
}