views 'Deployment' {

  // ═══════════════════════════════════════════════════
  //  AWS Infrastructure
  // ═══════════════════════════════════════════════════
  deployment view deployment_infra {
    title 'Infra / AWS EC2 Cluster'
    description '''
4-node K8s cluster in ap-southeast-1 default VPC.
3 × t3a.medium (2 vCPU, 4 GiB) + 1 × t3a.small (2 vCPU, 2 GiB).
All spot instances, 20 GB gp3 root, single AZ, single public subnet.
Cilium eBPF mesh — every node connects to every node.
'''

    include aws.vpc.*
    includeAncestors: true

    style aws { color bank_indigo }
    style aws.vpc.master { color bank_green }
    style aws.vpc.warpgate { color bank_red }
  }

  // ═══════════════════════════════════════════════════
  //  Pod Distribution
  // ═══════════════════════════════════════════════════
  deployment view deployment_app_pods {
    title 'Infra / Pod Distribution'
    description 'Worker-1: ingress + messaging (Kong, Frontend, api-producer ×2, NATS 1Gi PVC). Worker-2: services + data (4 Go services ×2, PostgreSQL 5Gi, Redis 1Gi). NetPol: default-deny + 7 allow-lists.'

    include
      aws.vpc.master.*,
      aws.vpc.worker1.*,
      aws.vpc.worker2.*
    includeAncestors: true

    style aws { color bank_indigo }
    style aws.vpc.master { color bank_green }
    style aws.vpc.worker1 { color sky }
    style aws.vpc.worker2 { color amber }
  }

  // ═══════════════════════════════════════════════════
  //  Post-Lockdown Security
  // ═══════════════════════════════════════════════════
  deployment view deployment_security {
    title 'Security / Post-Lockdown'
    description 'After `make lockdown`: SSH(22) + kube-api(6443) closed. Only 80/443 (Caddy) + 2222 (Warpgate SSH) open to internet. All management via `ssh -p 2222`. Warpgate on dedicated node with NoSchedule taint.'

    include aws.vpc.master, aws.vpc.warpgate, aws.vpc.worker1, aws.vpc.worker2
    includeAncestors: true

    style aws { color bank_indigo }
    style aws.vpc.master { color bank_green }
    style aws.vpc.warpgate { color bank_red }
  }
}