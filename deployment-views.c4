views {

  deployment view deployment_infra {
    title 'AWS Infrastructure — 4-node K8s Cluster'
    description 'ap-southeast-1 default VPC. 1 master + 2 workers + 1 warpgate. Cilium CNI kube-proxy replacement. Ansible 9-play bootstrapping.'

    include aws.vpc.*
    includeAncestors: true

    style aws {
      color bank_indigo
    }
  }

  deployment view deployment_app_pods {
    title 'Application Pod Distribution'
    description 'Worker-1: entry + messaging. Worker-2: services + data. Default-deny NetworkPolicy with 7 allow-lists.'

    include
      aws.vpc.worker1.*,
      aws.vpc.worker2.*
    includeAncestors: true

    style aws {
      color bank_indigo
    }
  }

  deployment view deployment_security {
    title 'Post-Lockdown Security'
    description 'SSH(22) + kube-api(6443) closed. Only 80/443 (Caddy) + 2222 (Warpgate SSH) open. kubectl audited via Warpgate sessions.'

    include aws.vpc.master, aws.vpc.warpgate, aws.vpc.worker1, aws.vpc.worker2
    includeAncestors: true

    style aws {
      color bank_indigo
    }
    style aws.vpc.master {
      color bank_green
    }
    style aws.vpc.warpgate {
      color bank_red
    }
  }

  deployment view deployment_audit {
    title 'Audit Logging Pipeline'
    description 'kube-apiserver → Vector(DaemonSet, hostPath) → Parseable(columnar SQL UI) → SeaweedFS(S3, 10Gi PVC). Disabled by default.'

    include aws.vpc.master
    includeAncestors: true

    style aws {
      color bank_indigo
    }
    style aws.vpc.master {
      color bank_green
    }
  }
}
