views 'Deployment' {

  // ═══════════════════════════════════════════════════
  //  AWS Infrastructure — physical topology
  // ═══════════════════════════════════════════════════
  deployment view deployment_infra {
    title 'Infra / AWS EC2 Cluster'
    description 'ap-southeast-1 default VPC. 3 × t3a.medium (master + 2 workers, 2 vCPU/4 GiB each) + 1 × t3a.small (warpgate, 2 vCPU/2 GiB). All spot instances, 20 GB gp3 root volumes. Single Security Group with two-phase rules (provisioning → lockdown). Single AZ, single public subnet.'

    include aws.vpc.*
    includeAncestors: true

    style aws { color bank_indigo }
    style aws.vpc.master { color bank_green }
    style aws.vpc.warpgate { color bank_red }
  }

  // ═══════════════════════════════════════════════════
  //  Application pod distribution
  // ═══════════════════════════════════════════════════
  deployment view deployment_app_pods {
    title 'Infra / Pod Distribution'
    description 'Worker-1 handles ingress + messaging: Kong, Frontend, api-producer (2 replicas, anti-affinity), NATS (1Gi PVC). Worker-2 handles services + data: 4 Go microservices (2 replicas each, hard pod anti-affinity), PostgreSQL (5Gi PV), Redis (1Gi PV). NetPol: default-deny + 7 allow-lists.'

    include
      aws.vpc.worker1.*,
      aws.vpc.worker2.*
    includeAncestors: true

    style aws { color bank_indigo }
    style aws.vpc.worker1 { color sky }
    style aws.vpc.worker2 { color amber }
  }

  // ═══════════════════════════════════════════════════
  //  Post-Lockdown Security
  // ═══════════════════════════════════════════════════
  deployment view deployment_security {
    title 'Security / Post-Lockdown'
    description 'After `make lockdown`: SSH(22) and kube-api(6443) rules removed from admin CIDR. Only ports open to internet: 80/443 (Caddy, TLS), 2222 (Warpgate SSH proxy). All management via `ssh -p 2222`. Warpgate on dedicated node with `NoSchedule` taint.'

    include aws.vpc.master, aws.vpc.warpgate, aws.vpc.worker1, aws.vpc.worker2
    includeAncestors: true

    style aws { color bank_indigo }
    style aws.vpc.master { color bank_green }
    style aws.vpc.warpgate { color bank_red }
  }

  // ═══════════════════════════════════════════════════
  //  Audit Logging Pipeline
  // ═══════════════════════════════════════════════════
  deployment view deployment_audit {
    title 'Security / Audit Pipeline'
    description 'kube-apiserver writes CIS-policy audit logs to `/var/log/kubernetes/audit/`. Vector (DaemonSet, hostPath) ships to Parseable (columnar store, SQL UI) → SeaweedFS (S3-compatible, 10Gi PVC). All on control-plane node (nodeSelector + tolerations).'

    include aws.vpc.master
    includeAncestors: true

    style aws { color bank_indigo }
    style aws.vpc.master { color bank_green }
  }

}