global {
  style mute_externals github, ghcr, duckdns, instana {
    color muted
    opacity 60%
  }

  styleGroup theme_banking {
    style banking.caddy, banking.nats, banking.jets { color sky }
    style banking.kong { color bank_indigo }
    style banking.auth, banking.account, banking.transfer, banking.notify { color amber }
    style banking.postgres { color secondary }
    style banking.redis { color red }
    style monitoring { color bank_green }
    style argocd { color sky }
    style infra_repo { color bank_indigo }
  }

  // ── View-level predicate groups for reuse ──
  predicateGroup external_services {
    include github, ghcr, duckdns, instana
  }
  predicateGroup gitops_infra {
    include argocd, infra_repo
  }
}

views 'Architecture' {

  // ═══════════════════════════════════════════════════
  //  Level 1: System Landscape (C4 Level 1)
  // ═══════════════════════════════════════════════════
  view index {
    title 'Landscape / C4 Level 1'
    description '''
**Banking Demo** ecosystem — event-driven banking app on K8s (AWS EC2). ArgoCD syncs Helm chart from banking-demo-gitops. Infrastructure provisioned by bankind-demo-infra (Terraform + Ansible). Monitoring stack runs in-cluster. Instana provides production observability.
'''
    global style mute_externals

    autoLayout LeftRight 150 100

    // Groups first — elements stay in their first group
    group 'External Services' {
      color muted
      opacity 30%
      border dashed
      include github, ghcr, duckdns, instana
    }
    group 'GitOps & Infrastructure' {
      color sky
      opacity 25%
      border dashed
      include argocd, infra_repo
    }

    // Remaining elements outside groups
    include
      customer,
      operator,
      banking with {
        navigateTo banking_system
      },
      monitoring

    exclude banking.ci

    style banking { color bank_green }
  }

  // ═══════════════════════════════════════════════════
  //  Level 2: Banking System — Container View
  // ═══════════════════════════════════════════════════
  view banking_system of banking {
    title 'Containers / C4 Level 2'
    description '''
**17 containers.** All traffic enters through Caddy (hostPort, on control-plane node) → Kong (ClusterIP, on worker-1) → routes by path: `/` → frontend, `/api` → api-producer, `/ws` → notification (WebSocket).

Backend services communicate over NATS RPC. PostgreSQL and Redis are StatefulSets with PersistentVolumes.
'''
    rank same { caddy }
    rank same { kong }
    rank same { frontend, producer }
    rank same { nats, jets }
    rank same { auth, account, transfer, notify }
    rank same { postgres, redis }

    autoLayout LeftRight 120 100

    // Groups first — elements belong to their first group
    group 'Ingress' {
      color bank_green
      opacity 25%
      border dashed
      include caddy
    }
    group 'Gateway + Web' {
      color bank_indigo
      opacity 20%
      border dashed
      include kong, frontend
    }
    group 'Bridge' {
      color primary
      opacity 20%
      border dashed
      include producer
    }
    group 'Message Bus' {
      color sky
      opacity 20%
      border dashed
      include nats, jets
    }
    group 'Consumers (Go)' {
      color amber
      opacity 15%
      border dashed
      include auth, account, transfer, notify
    }
    group 'Data' {
      color secondary
      opacity 20%
      border dashed
      include postgres, redis
    }

    // Styles applied after grouping
    global style theme_banking
    style caddy { color bank_green }
  }

  // ═══════════════════════════════════════════════════
  //  API Request Flow
  // ═══════════════════════════════════════════════════
  view api_flow of banking {
    title 'Requests / API Flow'
    description 'All requests hit Caddy (TLS termination) → Kong (routing by path) → three possible backends: SPA (`/`), API (`/api`), WebSocket (`/ws`). W3C traceparent propagated through NATS message headers.'

    include
      customer,
      caddy,
      kong,
      frontend,
      producer,
      nats,
      auth,
      account,
      transfer,
      notify

    include customer -> caddy
    include caddy -> kong
    include kong -> frontend, kong -> producer, kong -> notify
    include producer -> nats
    include nats -> auth, nats -> account, nats -> transfer, nats -> notify

    autoLayout TopBottom 100 80

    style caddy { color bank_green }
    style kong { color bank_indigo }
    style producer { color primary }
    style nats { color sky }
  }

  // ═══════════════════════════════════════════════════
  //  NATS Subject Hierarchy
  // ═══════════════════════════════════════════════════
  view nats_subjects of banking {
    title 'Messaging / NATS Subjects'
    description 'Core NATS request/reply (nats/micro) with queue groups for load balancing across replicas. JetStream durable event stream (30-day retention) with Nats-Msg-Id dedup.'

    include nats, auth, account, transfer, notify, jets

    include nats -> auth, nats -> account, nats -> transfer, nats -> notify
    include transfer -> jets
    include jets -> account

    autoLayout TopBottom 100 80

    style nats { color sky }
    style jets { color bank_amber }
    style auth, account, transfer, notify { color amber }
  }

  // ═══════════════════════════════════════════════════
  //  Transfer Flow — CQRS Three-Tier detail
  // ═══════════════════════════════════════════════════
  view transfer_flow of banking {
    title 'Features / Transfer Flow'
    description '''
**Three-tier CQRS transfer:**

1. **SerializableTx** — row-level lock, atomic debit+credit, 5× jitter retry on conflict
2. **Redis pipeline** — 5 commands in 1 RTT (invalidate cache, update balances, publish notification)
3. **JetStream** — publish event with Nats-Msg-Id dedup; account-service durable consumer replays on cold start to rebuild balance read model
'''
    autoLayout LeftRight 120 90

    group 'Tier 1 — Serializable Transaction' {
      color amber
      opacity 20%
      border dashed
      include
        transfer with {
          navigateTo transfer_sequence
        },
        postgres
    }
    group 'Tier 2 — Redis Pipeline' {
      color red
      opacity 15%
      border dashed
      include redis
    }
    group 'Tier 3 — JetStream' {
      color sky
      opacity 15%
      border dashed
      include jets, account
    }
    group 'WebSocket Push' {
      color bank_green
      opacity 15%
      border dashed
      include notify, customer
    }

    include transfer -> postgres
    include transfer -> redis
    include transfer -> jets
    include jets -> account
    include account -> postgres
    include account -> redis
    include redis -> notify
    include notify -> customer

    style transfer { color amber }
    style postgres { color secondary }
    style redis { color red }
    style jets { color bank_amber }
    style account { color primary }
    style notify { color sky }
  }

  // ═══════════════════════════════════════════════════
  //  Data Layer
  // ═══════════════════════════════════════════════════
  view data_layer of banking {
    title 'Data / PostgreSQL + Redis'
    description '4 services share one PostgreSQL database (banking) with 3 tables (users, transfers, notifications). Redis provides sessions, user cache, CQRS balance read model, and pub/sub notification channels. Both StatefulSets with PersistentVolumeClaims (5Gi + 1Gi on local-path).'

    include
      auth,
      account,
      transfer,
      notify,
      postgres,
      redis

    include auth -> postgres, auth -> redis
    include account -> postgres, account -> redis
    include transfer -> postgres, transfer -> redis
    include notify -> postgres, notify -> redis

    autoLayout TopBottom 100 80

    style postgres { color secondary }
    style redis { color red }
    style auth, account, transfer, notify { color amber }
  }

  // ═══════════════════════════════════════════════════
  //  Observability
  // ═══════════════════════════════════════════════════
  view observability_view {
    title 'Operations / Observability'
    description 'Every Go service exposes `/metrics` (Prometheus), `/health` (readiness), and exports OTLP/gRPC traces to Instana agent on :4317. Structured JSON logs via slog. Kong exports Prometheus + OTel via global plugins. NATS exporter on :7777. Self-hosted Grafana dashboard: "Banking Services".'

    group 'Signals (emitters)' {
      color amber
      opacity 15%
      border dashed
      include banking.auth, banking.account, banking.transfer, banking.notify, banking.producer, banking.nats
    }
    group 'Backends (collectors)' {
      color bank_indigo
      opacity 15%
      border dashed
      include monitoring, instana
    }

    include monitoring -> banking.auth, monitoring -> banking.account, monitoring -> banking.transfer, monitoring -> banking.notify, monitoring -> banking.producer, monitoring -> banking.nats
    include instana -> banking.auth, instana -> banking.account, instana -> banking.transfer, instana -> banking.notify, instana -> banking.producer

    style monitoring { color bank_green }
    style instana { color bank_indigo }
  }

}

views 'CI/CD' {

  // ═══════════════════════════════════════════════════
  //  GitOps CI/CD Pipeline
  // ═══════════════════════════════════════════════════
  view gitops_pipeline of banking {
    title 'Pipeline / GitOps CI/CD'
    description 'revamp (GitHub Actions matrix build) → GHCR (multi-arch images) → gitops (auto-commit tag bump) → ArgoCD (auto-sync + prune + selfHeal). Infra repo provisions EC2 + K8s + ArgoCD via Terraform + Ansible 9-play site.yml.'

    include
      ci,
      github,
      ghcr,
      argocd,
      infra_repo

    include ci -> github, ci -> ghcr
    include github -> argocd, ghcr -> argocd
    include argocd -> banking, infra_repo -> banking
    include infra_repo -> argocd

    autoLayout LeftRight 120 100

    style ci { color amber }
    style argocd { color sky }
    style infra_repo { color bank_indigo }
  }

}