views {

  view index {
    title 'System Landscape'
    description """
        **C4 Level 1 — System Context**

        High-level view of the Banking Demo ecosystem. The Banking System is a Go/React event-driven banking application deployed on K8s (EC2). Infrastructure provisioned by Terraform + Ansible from bankind-demo-infra. ArgoCD syncs the Helm chart from banking-demo-gitops.
        """
    link https://github.com/dungxnd-banking-demo/banking-demo-revamp

    include
      customer,
      operator,
      github,
      ghcr,
      duckdns,
      instana,
      banking,
      infraRepo,
      argocd

    style banking {
      color bank-green
    }
    style infraRepo {
      color bank-indigo
    }
    style argocd {
      color sky
    }
  }

  view banking-system of banking {
    title 'Banking System — Containers'
    description """
        **C4 Level 2 — Container View**

        All 17 containers. Request flow: Browser → Caddy (TLS) → Kong (ClusterIP) → api-producer (Go/chi) → NATS RPC → 4 consumer services → PostgreSQL + Redis. WebSocket bypasses NATS: Kong → notification-service directly.
        """

    include *

    autoLayout LeftRight 120 100

    style caddy {
      color bank-green
    }
    style kong {
      color bank-indigo
    }
    style producer {
      color primary
    }
    style nats {
      color sky
    }
    style jets {
      color bank-amber
    }
    style auth, account, transfer, notify {
      color amber
    }
    style postgres {
      color secondary
    }
    style redis {
      color red
    }

    group 'Entry Layer' {
      include caddy, frontend
    }
    group 'Gateway + Bridge' {
      include kong, producer
    }
    group 'Message Bus' {
      include nats, jets
    }
    group 'Consumer Services' {
      include auth, account, transfer, notify
    }
    group 'Data Layer' {
      include postgres, redis
    }
  }

  view api-request-flow of banking {
    title 'API Request Flow'
    description """
        **How an HTTP API call flows through the system.**

        Path mapping: `POST /api/transfers` → `banking.transfer.transfer` via exact-match switch in producer/handlers.go. Auth headers (X-Session, X-Admin-Secret) travel as NATS message headers, not in JSON body. W3C traceparent injected. Nats-Trace-Dest sampled at 1% for server-level tracing.
        """
    link https://github.com/dungxnd-banking-demo/banking-demo-revamp/blob/main/producer/handlers.go

    include
      customer,
      caddy,
      kong,
      producer,
      nats,
      auth,
      account,
      transfer,
      notify

    style caddy {
      color bank-green
    }
    style kong {
      color bank-indigo
    }
    style producer {
      color primary
    }
    style nats {
      color sky
    }
  }

  view nats-subjects of banking {
    title 'NATS Subject Hierarchy'
    description """
        **RPC subjects (Core NATS) + JetStream events.**

        Each consumer registers as a nats/micro service with per-action endpoints using full subject as queue group. Auth headers travel as NATS message headers. JetStream events published with Nats-Msg-Id:{transferID} for dedup.
        """
    link https://github.com/dungxnd-banking-demo/banking-demo-revamp/blob/main/ARCH-NATS-RPC.md

    include nats, auth, account, transfer, notify, jets

    style nats {
      color sky
    }
    style jets {
      color bank-amber
    }
  }

  view transfer-flow of banking {
    title 'Transfer Flow — CQRS'
    description """
        **Money transfer with three-tier CQRS.**

        **Tier 1 (DB):** `SerializableTx` with jitter retry (up to 5x). Determistic lock ordering: `SELECT FOR UPDATE WHERE id IN (?,?) ORDER BY id`. Single UPDATE with CASE WHEN for balances. Atomic insert of transfer + 2 notifications.

        **Tier 2 (Redis):** Post-commit pipeline in ONE round-trip: `DEL user_cache:phone`, `HSET balance {sender}`, `HSET balance {receiver}`, `PUBLISH notify:{receiver}`.

        **Tier 3 (JetStream):** `PublishMsg` with `Nats-Msg-Id:{transferID}` header. Account-service durable pull consumer replays on cold start to rebuild balance hash without DB reads.
        """
    link https://github.com/dungxnd-banking-demo/banking-demo-revamp/blob/main/MICROSERVICES.md

    include
      customer,
      transfer,
      nats,
      jets,
      account,
      postgres,
      redis,
      notify

    style transfer {
      color amber
    }
    style jets {
      color bank-amber
    }
    style postgres {
      color secondary
    }
    style redis {
      color red
    }
    style account {
      color primary
    }
    style notify {
      color sky
    }

    group 'Tier 1 — SerializableTx' {
      include transfer, postgres
    }
    group 'Tier 2 — Redis Pipeline' {
      include redis
    }
    group 'Tier 3 — JetStream Event Log' {
      include jets, account
    }
    group 'Real-time Notification' {
      include notify, customer
    }
  }

  view data-layer of banking {
    title 'Data Layer'
    description """
        **PostgreSQL schema and Redis key space.**

        PostgreSQL: users (BIGINT PK, phone/account_number/username UNIQUE, balance ≥ 0), transfers (BIGINT, FK, amount > 0, composite indexes), notifications (BIGINT, FK, is_read). Migrated via golang-migrate in 3 steps.

        Redis: sessions (24h), user_cache (5min, DEL'd post-transfer), balance hash (CQRS read model, no TTL), presence (60s, WS heartbeat), notify:{uid} pub/sub channel.
        """

    include auth, account, transfer, notify, postgres, redis

    style postgres {
      color secondary
    }
    style redis {
      color red
    }
  }

  view observability-stack of banking {
    title 'Observability Stack'
    description """
        **Three pillars: structured JSON logs (slog), Prometheus metrics, OpenTelemetry distributed tracing.**

        All services expose /metrics via promhttp, emit JSON logs to stdout (slog), and export OTLP/gRPC traces (→ Instana agent or OTel Collector). NATS micro provides per-endpoint stats. nginx has ngx_otel_module. Instana Go Collector instruments pgxpool and go-redis.
        """

    include
      auth,
      account,
      transfer,
      notify,
      producer,
      nats,
      monitoring,
      instana

    style monitoring {
      color bank-green
    }
    style instana {
      color bank-indigo
    }

    group 'Signals emitted' {
      include auth, account, transfer, notify, producer, nats
    }
    group 'Backends' {
      include monitoring, instana
    }
  }

  view gitops-pipeline of banking {
    title 'GitOps CI/CD Pipeline'
    description """
        **Three repos, one pipeline.**

        1. banking-demo-revamp: GitHub Actions builds Go (GOWORK=off) + React (node:24→nginx:alpine) images, pushes to GHCR
        2. CI bumps image tags in banking-demo-gitops/helm/values.yaml (Stage 3)
        3. ArgoCD detects diff → auto-syncs (prune + selfHeal, 3-retry backoff)
        4. bankind-demo-infra: Terraform (spot EC2, SG) + Ansible (os-hardening, containerd, kubeadm, Cilium, ArgoCD install)
        """

    include ci, argocd

    style ci {
      color amber
    }
    style argocd {
      color bank-green
    }
  }

  view redis-keyspace of banking {
    title 'Redis Key Space & CQRS'
    description """
        **How Redis enables CQRS and real-time notifications.**

        - `session:{sid}` → user ID lookup (all services, 24h TTL)
        - `user_cache:{phone}` → login fast-path (auth writes, transfer DEL's on commit, 5min TTL)
        - `balance` hash → CQRS read model (transfer HSET, account HGet O(1) → DB fallback + backfill)
        - `notify:{uid}` pub/sub → transfer PUBLISH, notify SUBSCRIBE → WebSocket JSON frame push
        - `presence:{uid}` → online status heartbeat at TTL/3 interval
        """
    include redis, auth, account, transfer, notify

    style redis {
      color red
    }
  }
}
