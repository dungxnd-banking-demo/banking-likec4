global {
  style mute_externals github, ghcr, duckdns, letsencrypt, instana {
    color muted
    opacity 60%
  }

  styleGroup theme_banking {
    style banking.nats, banking.jets { color sky }
    style banking.kong { color bank_indigo }
    style banking.auth, banking.account, banking.transfer, banking.notify { color amber }
    style banking.postgres { color secondary }
    style banking.redis { color red }
    style monitoring { color bank_green }
    style k8s_platform.argocd { color sky }
    style infra_repo { color bank_indigo }
    style devsecops { color amber }
  }
}

views 'Architecture' {

  // ═══════════════════════════════════════════════════
  //  System Landscape
  // ═══════════════════════════════════════════════════
  view index {
    title 'Landscape / System Overview'
    description '''
**Banking Demo Platform** — 4-node K8s cluster on AWS EC2 (ap-southeast-1).
Event-driven banking app, self-hosted observability, DevSecOps pipeline with 9 parallel security scans.
GitOps deployment via ArgoCD. Zero-trust SSH bastion via Warpgate.
'''
    global style mute_externals

    autoLayout LeftRight 150 100

    group 'External Services' {
      color muted
      opacity 30%
      border dashed
      include github, ghcr, duckdns, letsencrypt, instana
    }
    group 'Infrastructure' {
      color bank_indigo
      opacity 25%
      border dashed
      include infra_repo
    }
    group 'Platform' {
      color sky
      opacity 20%
      border dashed
      include k8s_platform, banking, monitoring
    }

    include
      customer,
      operator

    style k8s_platform { color bank_green }
    style banking { color amber }
  }

  // ═══════════════════════════════════════════════════
  //  K8s Platform — internals
  // ═══════════════════════════════════════════════════
  view platform_internals of k8s_platform {
    title 'Containers / K8s Platform Internals'
    description 'Control plane, CNI, storage, GitOps controller, edge proxy, security layers. All deployed by Ansible 9-play site.yml.'

    include *
    autoLayout LeftRight 120 100

    style control_plane { color primary }
    style cilium { color sky }
    style local_path { color secondary }
    style caddy { color bank_green }
    style argocd { color sky }
    style warpgate { color bank_red }
    style sg { color gray }
    style audit { color gray }
    style netpol { color gray }
  }

  // ═══════════════════════════════════════════════════
  //  Banking Application — Container View
  // ═══════════════════════════════════════════════════
  view banking_system {
    title 'Containers / Banking Application'
    description '''
**13 containers.** Traffic: Caddy(TLS, hostPort) → Kong(ClusterIP) → routes by path:
`/` → frontend, `/api` → api-producer, `/ws` → notification (WebSocket).

Backend services communicate over NATS RPC. PostgreSQL + Redis StatefulSets with PVs.
'''

    rank same { k8s_platform.caddy }
    rank same { banking.kong }
    rank same { banking.frontend, banking.producer }
    rank same { banking.nats, banking.jets }
    rank same { banking.auth, banking.account, banking.transfer, banking.notify }
    rank same { banking.postgres, banking.redis }

    autoLayout LeftRight 120 100

    global style theme_banking

    group 'Ingress' {
      color bank_green;
      opacity 25%;
      border dashed
      include k8s_platform.caddy
    }
    group 'Gateway + Web' {
      color bank_indigo;
      opacity 20%;
      border dashed
      include banking.kong, banking.frontend
    }
    group 'Bridge' {
      color primary;
      opacity 20%;
      border dashed
      include banking.producer
    }
    group 'Message Bus' {
      color sky;
      opacity 20%;
      border dashed
      include banking.nats, banking.jets
    }
    group 'Consumers (Go)' {
      color amber;
      opacity 15%;
      border dashed
      include banking.auth, banking.account, banking.transfer, banking.notify
    }
    group 'Data' {
      color secondary;
      opacity 20%;
      border dashed
      include banking.postgres, banking.redis
    }

    style k8s_platform.caddy { color bank_green }
  }

  view api_flow {
    title 'Requests / API Flow'
    description 'All requests: Caddy (TLS) → Kong (routing by path) → three backends: SPA, API, WebSocket. W3C traceparent in NATS headers.'

    include
      customer,
      k8s_platform.caddy,
      banking.kong,
      banking.frontend,
      banking.producer,
      banking.nats,
      banking.auth,
      banking.account,
      banking.transfer,
      banking.notify

    include customer -> k8s_platform.caddy
    include k8s_platform.caddy -> banking.kong
    include banking.kong -> banking.frontend, banking.kong -> banking.producer, banking.kong -> banking.notify
    include banking.producer -> banking.nats
    include banking.nats -> banking.auth, banking.nats -> banking.account, banking.nats -> banking.transfer, banking.nats -> banking.notify

    autoLayout TopBottom 100 80

    style k8s_platform.caddy { color bank_green }
    style banking.kong { color bank_indigo }
    style banking.producer { color primary }
    style banking.nats { color sky }
  }

  // ═══════════════════════════════════════════════════
  //  NATS Subject Hierarchy
  // ═══════════════════════════════════════════════════
  view nats_subjects of banking {
    title 'Messaging / NATS Subjects'
    description 'Core NATS request/reply (nats/micro) with queue groups. JetStream durable stream (30-day retention, Nats-Msg-Id dedup).'

    include nats, auth, account, transfer, notify, jets
    include nats -> auth, nats -> account, nats -> transfer, nats -> notify
    include transfer -> jets
    include jets -> account

    autoLayout TopBottom 100 80
    style nats { color sky }
    style jets { color bank_amber }
    style auth, account, transfer, notify { color amber }
  }

  view transfer_flow of banking {
    title 'Features / Transfer Flow'
    description '''
**Three-tier CQRS transfer:**

1. **SerializableTx** — row-level lock, atomic debit+credit, 5× jitter retry on conflict
2. **Redis pipeline** — 5 commands in 1 RTT (invalidate cache, update balances, publish notification)
3. **JetStream** — publish event with Nats-Msg-Id dedup; account-service durable consumer replays on cold start
'''
    autoLayout LeftRight 120 90

    group 'Tier 1 — Serializable Transaction' {
      color amber;
      opacity 20%;
      border dashed
      include transfer, postgres
    }
    group 'Tier 2 — Redis Pipeline' {
      color red;
      opacity 15%;
      border dashed
      include redis
    }
    group 'Tier 3 — JetStream' {
      color sky;
      opacity 15%;
      border dashed
      include jets, account
    }
    group 'WebSocket Push' {
      color bank_green;
      opacity 15%;
      border dashed
      include notify, customer
    }

    include transfer -> postgres
    include transfer -> redis
    include transfer -> jets
    include jets -> account
    include account -> postgres
    include account -> redis
    include redis -> notify
    include notify -> customer

    style transfer { color amber }
    style postgres { color secondary }
    style redis { color red }
    style jets { color bank_amber }
    style account { color primary }
    style notify { color sky }
  }

  view data_layer of banking {
    title 'Data / PostgreSQL + Redis'
    description '4 services share one PostgreSQL database (3 tables). Redis: sessions, user cache, CQRS balance read model, pub/sub. Both StatefulSets (5Gi + 1Gi on local-path).'

    include auth, account, transfer, notify, postgres, redis
    include auth -> postgres, auth -> redis
    include account -> postgres, account -> redis
    include transfer -> postgres, transfer -> redis
    include notify -> postgres, notify -> redis

    autoLayout TopBottom 100 80

    style postgres { color secondary }
    style redis { color red }
    style auth, account, transfer, notify { color amber }
  }
}

views 'Observability' {

  // ═══════════════════════════════════════════════════
  //  Observability Stack
  // ═══════════════════════════════════════════════════
  view observability_view of monitoring {
    title 'Operations / Observability Stack'
    description '''
Self-hosted in-cluster. Namespace: `monitoring`.

Services emit `/metrics` (Prometheus, 15s scrape) and OTLP/gRPC traces.
OTel Collector → Jaeger. Grafana dashboards: request rate + p99 latency.
Instana (external APM) collects OTLP in production.
'''

    include *

    autoLayout TopBottom 100 80

    style prometheus { color bank_green }
    style grafana { color bank_indigo }
    style jaeger { color sky }
    style otel_collector { color amber }
  }
}

views 'CI/CD' {

  // ═══════════════════════════════════════════════════
  //  GitOps CI/CD Pipeline
  // ═══════════════════════════════════════════════════
  view gitops_pipeline of devsecops {
    title 'Pipeline / GitOps CI/CD'
    description 'On push to main: matrix build → GHCR push → yq tag bump in gitops → ArgoCD auto-sync (prune + selfHeal). On PR: 9 parallel security scans block merge.'

    include *
    include github, ghcr

    include ci_build -> github, ci_build -> ghcr
    include security_scanners -> ci_build
    include github -> k8s_platform.argocd, ghcr -> k8s_platform.argocd
    include gitops_update -> github
    include perf_test -> banking

    autoLayout LeftRight 120 100

    style ci_build { color amber }
    style k8s_platform.argocd { color sky }
    style security_scanners { color bank_red }
  }
}