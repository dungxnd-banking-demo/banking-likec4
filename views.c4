global {

  style mute_externals github, ghcr, duckdns, instana {
    color muted
    opacity 60%
  }
}

views {

  // ═══════════════════════════════════════════════════
  //  Level 1: System Landscape (C4 Level 1)
  // ═══════════════════════════════════════════════════
  view index {
    title 'System Landscape — C4 Level 1'
    description '''
        **Banking Demo** ecosystem — event-driven banking app on K8s (AWS EC2).

        ArgoCD syncs the Helm chart from banking-demo-gitops.
        Infrastructure provisioned by bankind-demo-infra (Terraform + Ansible).
        Monitoring stack runs in-cluster. Instana provides production observability.
        '''

    // include * auto-derives all top-level elements + their relationships
    include *
    exclude banking.ci

    autoLayout LeftRight 150 100

    style banking { color bank_green }
    style argocd { color sky }
    style infra_repo { color bank_indigo }

    group 'External Services' {
      include github, ghcr, duckdns, instana
    }
    group 'GitOps & Infrastructure' {
      include argocd, infra_repo
    }
  }

  // ═══════════════════════════════════════════════════
  //  Level 2: Banking System — Container View
  // ═══════════════════════════════════════════════════
  view banking_system of banking {
    title 'Banking System — Containers (C4 Level 2)'
    description '''
        **17 containers**. Request flow: Browser → Caddy(TLS) → Kong(ClusterIP) → api-producer → NATS RPC → 4 services → PG+Redis.
        WebSocket bypasses NATS: Kong → notification-service directly.
        '''
    include *

    rank same { caddy, frontend }
    rank same { kong, producer }
    rank same { nats, jets }
    rank same { auth, account, transfer, notify }
    rank same { postgres, redis }

    autoLayout LeftRight 120 100

    style caddy { color bank_green }
    style kong { color bank_indigo }
    style producer { color primary }
    style nats, jets { color sky }
    style auth, account, transfer, notify { color amber }
    style postgres { color secondary }
    style redis { color red }

    group 'Entry' {
      include caddy, frontend
    }
    group 'Gateway + Bridge' {
      include kong, producer
    }
    group 'Message Bus' {
      include nats, jets
    }
    group 'Consumer Services' {
      include auth, account, transfer, notify
    }
    group 'Data' {
      include postgres, redis
    }
  }

  // ═══════════════════════════════════════════════════
  //  API Request Flow
  // ═══════════════════════════════════════════════════
  view api_flow of banking {
    title 'API Request Flow'
    description 'GET/POST: Browser → Caddy → Kong → api-producer → NATS RPC → service. Auth headers in NATS message headers. W3C traceparent + Nats-Trace-Dest(1%).'

    include
      customer,
      caddy,
      kong,
      producer,
      nats,
      auth,
      account,
      transfer,
      notify

    include customer -> caddy
    include caddy -> kong
    include kong -> producer
    include kong -> notify
    include producer -> nats
    include nats -> auth, nats -> account, nats -> transfer, nats -> notify

    autoLayout TopBottom 100 80

    style caddy { color bank_green }
    style kong { color bank_indigo }
    style producer { color primary }
    style nats { color sky }
  }

  // ═══════════════════════════════════════════════════
  //  NATS Subject Hierarchy
  // ═══════════════════════════════════════════════════
  view nats_subjects of banking {
    title 'NATS Subject Hierarchy'
    description 'Core NATS request/reply (nats/micro) + JetStream durable events. Full subject = queue group for auto load-balancing across replicas.'

    include nats, auth, account, transfer, notify, jets

    include nats -> auth, nats -> account, nats -> transfer, nats -> notify
    include transfer -> jets
    include jets -> account

    autoLayout TopBottom 100 80

    style nats { color sky }
    style jets { color bank_amber }
  }

  // ═══════════════════════════════════════════════════
  //  Transfer Flow — CQRS detail
  // ═══════════════════════════════════════════════════
  view transfer_flow of banking {
    title 'Transfer Flow — CQRS Three-Tier'
    description '''
        **Tier 1 (PostgreSQL):** SerializableTx (5× jitter retry on 40001). Lock ORDER BY id. Atomic debit+credit+3 inserts.

        **Tier 2 (Redis):** Post-commit pipeline — 5 commands in 1 RTT: DEL user_cache(×2), HSET balance(×2), PUBLISH notify.

        **Tier 3 (JetStream):** PublishMsg with Nats-Msg-Id dedup. Account durable pull consumer replays on cold start to rebuild balance hash.
        '''
    include
      customer,
      transfer,
      postgres,
      redis,
      jets,
      account,
      notify

    include transfer -> postgres
    include transfer -> redis
    include transfer -> jets
    include jets -> account
    include account -> postgres
    include account -> redis
    include redis -> notify
    include notify -> customer

    autoLayout LeftRight 120 90

    style transfer { color amber }
    style postgres { color secondary }
    style redis { color red }
    style jets { color bank_amber }
    style account { color primary }
    style notify { color sky }

    group 'Tier 1 — SerializableTx' {
      include transfer, postgres
    }
    group 'Tier 2 — Redis Pipeline' {
      include redis
    }
    group 'Tier 3 — JetStream' {
      include jets, account
    }
    group 'WebSocket Push' {
      include notify, customer
    }
  }

  // ═══════════════════════════════════════════════════
  //  Data Layer
  // ═══════════════════════════════════════════════════
  view data_layer of banking {
    title 'Data Layer — PostgreSQL + Redis'
    description 'PostgreSQL tables + Redis key space. 4 services share one DB (banking). Redis provides sessions, cache, CQRS read model, and pub/sub.'

    include
      auth,
      account,
      transfer,
      notify,
      postgres,
      redis

    include auth -> postgres,    auth -> redis
    include account -> postgres, account -> redis
    include transfer -> postgres, transfer -> redis
    include notify -> postgres,  notify -> redis

    autoLayout TopBottom 100 80

    style postgres { color secondary }
    style redis { color red }
  }

  // ═══════════════════════════════════════════════════
  //  Observability
  // ═══════════════════════════════════════════════════
  view observability_view {
    title 'Observability — Logs, Metrics, Traces'
    description 'All services emit structured JSON logs (slog), expose /metrics (Prometheus), and export OTLP/gRPC traces → Instana or OTel Collector → Jaeger.'

    include
      monitoring,
      instana,
      banking.auth,
      banking.account,
      banking.transfer,
      banking.notify,
      banking.producer,
      banking.nats

    include monitoring -> banking.auth,  monitoring -> banking.account,  monitoring -> banking.transfer,  monitoring -> banking.notify,  monitoring -> banking.producer,  monitoring -> banking.nats
    include instana   -> banking.auth,  instana   -> banking.account,  instana   -> banking.transfer,  instana   -> banking.notify,  instana   -> banking.producer

    group 'Services (signals)' {
      include banking.auth, banking.account, banking.transfer, banking.notify, banking.producer, banking.nats
    }
    group 'Backends' {
      include monitoring, instana
    }

    style monitoring { color bank_green }
    style instana { color bank_indigo }
  }

  // ═══════════════════════════════════════════════════
  //  GitOps CI/CD Pipeline
  // ═══════════════════════════════════════════════════
  view gitops_pipeline of banking {
    title 'GitOps CI/CD Pipeline'
    description '3 repos, 1 pipeline: revamp(CI)→GHCR → gitops(tag bump)→ArgoCD(auto-sync). bankind-demo-infra provisions EC2+K8s+ArgoCD. banking-likec4 documents architecture.'

    include
      ci,
      github,
      ghcr,
      argocd,
      infra_repo

    include ci      -> github,     ci      -> ghcr
    include github  -> argocd,     ghcr    -> argocd
    include argocd  -> banking,    infra_repo -> banking
    include infra_repo -> argocd

    autoLayout LeftRight 120 100

    style ci { color amber }
    style argocd { color sky }
    style infra_repo { color bank_indigo }
  }
}
