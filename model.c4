model {

  // ── Actors ──
  customer = actor 'Customer' {
    description 'End user with a web browser. Logs in, checks balance, sends money, receives real-time WebSocket notifications.'
  }
  operator = operator 'Operations Engineer' {
    description 'Manages infra and deploys via GitOps. Accesses cluster through Warpgate SSH proxy (2222).'
  }

  // ── External Systems ──
  github = system 'GitHub' {
    description 'Hosts source code, Helm chart + ArgoCD manifests, and runs CI via GitHub Actions.'
  }
  ghcr = system 'GHCR' {
    description 'GitHub Container Registry — stores Docker images built by CI.'
    technology 'OCI Registry'
  }
  duckdns = system 'DuckDNS' {
    description 'Free dynamic DNS. systemd service on master node keeps A-record pointed at EC2 public IP.'
    technology 'Dynamic DNS'
  }
  instana = system 'Instana' {
    description 'Production observability backend. Host agent collects OTLP/gRPC traces on :4317. Go services use Instana Go Collector. Synthetic monitoring scripts for health, login, transfer, auth edge cases.'
    technology 'Instana'
  }

  // ── Infrastructure repo (provisioning) ──
  infraRepo = system 'bankind-demo-infra' {
    description 'Terraform (spot EC2, SG) + Ansible (os-hardening, containerd, kubeadm, Cilium, ArgoCD). 4 nodes: 1 master + 2 workers + 1 warpgate. Locks down SSH(22) + kube-apiserver(6443) post-provision.'
    technology 'Terraform · Ansible'
  }

  // ── ArgoCD (GitOps bridge, not inside banking) ──
  argocd = system 'ArgoCD' {
    description 'GitOps controller watching banking-demo-gitops/main/helm/. Automated sync with prune + selfHeal + 3-retry backoff. Server-side apply for Kong config.'
    technology 'ArgoCD'
  }

  // ── Banking System ──
  banking = system 'Banking System' {
    description 'Full-stack event-driven banking application: React SPA → Caddy → Kong → api-producer (Go/chi) → NATS RPC → 4 Go microservices → PostgreSQL + Redis. CQRS read model via Redis balance hash + JetStream event log.'

    caddy = proxy 'Caddy' {
      #gateway-tag
      title 'Caddy 2.11'
      description 'Edge proxy on control-plane node (hostPort 80/443/2222, hostNetwork). TLS termination via Let\'s Encrypt HTTP-01 challenge. Reverse-proxies to Kong (ClusterIP) and Warpgate. HTTP→HTTPS redirect.'
      technology 'Caddy Server'
    }

    frontend = webapp 'Frontend SPA' {
      description 'React 19 + Vite 8 + Tailwind CSS 4. Served by nginx:alpine with ngx_otel_module for trace span export. Proxies /api/* and /ws to Kong:8000. WebSocket for live transfer notifications with optimistic balance update.'
      technology 'React 19'
    }

    kong = gateway 'Kong Gateway' {
      #gateway-tag
      title 'Kong 3.9'
      description 'API gateway (DB-less, ClusterIP). Routes /api/* → api-producer, /ws → notification-service. Global plugins: Prometheus metrics, OpenTelemetry tracing → Instana. Per-route: CORS, rate-limiting, request-size-limiting.'
      technology 'Kong Gateway'
    }

    producer = bridge 'API Producer' {
      title 'api-producer :8080'
      description 'Stateless HTTP → NATS RPC proxy. chi router + otelhttp middleware + Instana TracingHandlerFunc. Maps RESTful paths to NATS subjects. Injects W3C traceparent + Nats-Trace-Dest (1% sampled) headers. Unknown paths → 404 without NATS round-trip. 60s response timeout.'
      technology 'Go 1.26'
    }

    nats = messagebus 'NATS' {
      #event-driven
      title 'NATS 2 + JetStream'
      description 'Core NATS request/reply via nats/micro framework (per-action endpoints with queue groups). JetStream: BANKING_EVENTS stream (30-day LimitsPolicy, 5-min Nats-Msg-Id dedup). nats-exporter sidecar scrapes /varz/connz/subsz → Prometheus at :7777.'
      technology 'NATS'
    }

    jets = eventbus 'JetStream Event Log' {
      #cqrs #event-driven
      title 'BANKING_EVENTS'
      description 'JetStream stream capturing banking.events.transfer.completed. Durable pull consumer (account-service-balance, DeliverAllPolicy, MaxAckPending=100) replays on cold start to rebuild Redis balance hash without touching DB.'
      technology 'NATS JetStream'
    }

    auth = microservice 'Auth Service' {
      title 'auth-service :8001'
      description 'Register (12-digit account number, bcrypt), login (Redis user_cache:phone/username → DB fallback + backfill), logout (DEL session). NATS subjects: banking.auth.register, banking.auth.login, banking.auth.logout. Go/chi + pgxpool (15 conns, 30s statement_timeout).'
      technology 'Go 1.26'
    }

    account = microservice 'Account Service' {
      #cqrs
      title 'account-service :8002'
      description 'User: me, balance (Redis HGet O(1) → DB fallback + backfill), lookup. Admin (RequireAdmin): stats (aggregate counts), users (paginated + ILIKE search), transfers (+ username resolution), notifications, user-detail. Balance projection goroutine consumes BANKING_EVENTS with DeliverAllPolicy. Shared NATS conn for RPC + JetStream.'
      technology 'Go 1.26'
    }

    transfer = microservice 'Transfer Service' {
      #cqrs
      title 'transfer-service :8003'
      description 'Atomic transfer: SerializableTx (retries SQLSTATE 40001 up to 5x with jitter), deterministic lock ordering (SELECT FOR UPDATE ORDER BY id). Post-commit Redis pipeline (DEL user_cache, HSET balance, PUBLISH notify) + JetStream publish (Nats-Msg-Id dedup). Amounts logged via HMAC masking.'
      technology 'Go 1.26'
    }

    notify = microservice 'Notification Service' {
      title 'notification-service :8004'
      description 'NATS: notifications (last 50), ack (mark read, user_id guard). WebSocket via coder/websocket: auth via ?session= query param, presence heartbeat at TTL/3 interval. Subscribes to notify:{userID} Redis pub/sub → JSON frame push. WriteTimeout: 0 for long-lived WS. OTel via otelhttp.NewHandler.'
      technology 'Go 1.26'
    }

    postgres = database 'PostgreSQL' {
      title 'PostgreSQL 18'
      description 'Primary DB (banking). Tables: users (BIGINT PK, phone/account_number/username UNIQUE, balance INTEGER ≥ 0), transfers (BIGINT, from_user/to_user FK, amount > 0, composite indexes), notifications (BIGINT, user_id FK, is_read). Migrations: 000001_init, 000002_constraints_and_indexes, 000003_bigint_ids.'
      technology 'PostgreSQL 18'
    }

    redis = cache 'Redis' {
      title 'Redis 8'
      description 'session:{sid} (24h TTL), user_cache:phone (5min, DEL\'d post-transfer), balance hash (no TTL, CQRS read model), presence:{uid} (60s, WS heartbeat), notify:{uid} pub/sub channel. Instana instrumentation hook on client.'
      technology 'Redis 8'
    }

    monitoring = observability 'Monitoring Stack' {
      description 'Self-hosted in monitoring namespace: Prometheus (4 scrape jobs, 15s interval), Grafana 11.2 (pre-built "Banking Services" dashboard), Jaeger all-in-one (OTLP ingest), OTel Collector (OTLP→Jaeger+logging). nginx Ingress for UI access.'
      technology 'Prometheus · Grafana · Jaeger'
    }

    ci = system 'CI Pipeline' {
      description 'GitHub Actions: Stage 1 builds Docker images (Go services via GOWORK=off + React via node:24-alpine→nginx:alpine), pushes to GHCR. Stage 3 bumps image tags in banking-demo-gitops helm/values.yaml.'
      technology 'GitHub Actions'
    }
  }

  // ── Relationships ──

  customer -[http]-> banking.caddy 'opens app in browser'

  banking.caddy -[http]-> banking.frontend 'serves SPA'
  banking.caddy -[http]-> banking.kong 'reverse_proxy → ClusterIP'
  banking.frontend -[http]-> banking.kong '/api/* and /ws (nginx proxy_pass)'

  banking.kong -[http]-> banking.producer '/api/* routes'
  banking.kong -[ws]-> banking.notify '/ws direct route'

  banking.producer -[nats-rpc]-> banking.nats 'maps RESTful path → NATS subject'

  banking.nats -[nats-rpc]-> banking.auth 'banking.auth.{register,login,logout}'
  banking.nats -[nats-rpc]-> banking.account 'banking.account.{me,balance,lookup,stats,users,transfers,notifications,user-detail}'
  banking.nats -[nats-rpc]-> banking.transfer 'banking.transfer.transfer'
  banking.nats -[nats-rpc]-> banking.notify 'banking.notification.{notifications,ack}'

  banking.transfer -[nats-jetstream]-> banking.jets 'banking.events.transfer.completed'
  banking.jets -[nats-jetstream]-> banking.account 'durable pull consumer (DeliverAll)'

  banking.auth -[sql]-> banking.postgres 'users table'
  banking.account -[sql]-> banking.postgres 'queries + admin aggregations'
  banking.transfer -[sql]-> banking.postgres 'SerializableTx (debit, credit, insert transfers + notifications)'
  banking.notify -[sql]-> banking.postgres 'notifications table'

  banking.auth -[redis-pubsub]-> banking.redis 'sessions + user_cache'
  banking.account -[redis-pubsub]-> banking.redis 'balance hash (CQRS read model)'
  banking.transfer -[redis-pubsub]-> banking.redis 'DEL cache, HSET balance, PUBLISH notify (pipeline)'
  banking.notify -[redis-pubsub]-> banking.redis 'SUBSCRIBE notify:{uid} → WebSocket push'

  banking.monitoring -[http]-> banking.auth 'scrape /metrics (15s)'
  banking.monitoring -[http]-> banking.account 'scrape /metrics (15s)'
  banking.monitoring -[http]-> banking.transfer 'scrape /metrics (15s)'
  banking.monitoring -[http]-> banking.notify 'scrape /metrics (15s)'
  banking.monitoring -[http]-> banking.producer 'scrape /metrics (15s)'
  banking.monitoring -[http]-> banking.nats 'scrape :8222 (nats-exporter)'

  instana -[http]-> banking.auth 'OTLP/gRPC :4317'
  instana -[http]-> banking.account 'OTLP/gRPC :4317'
  instana -[http]-> banking.transfer 'OTLP/gRPC :4317'
  instana -[http]-> banking.notify 'OTLP/gRPC :4317'
  instana -[http]-> banking.producer 'OTLP/gRPC :4317'

  banking.ci -[deploy]-> github 'reads source'
  banking.ci -[deploy]-> ghcr 'pushes images'
  github -[sync-gitops]-> argocd 'watches helm/ chart'
  ghcr -[deploy]-> argocd 'pulls images'
  argocd -[deploy]-> banking 'syncs manifests (prune + selfHeal)'

  duckdns -[http]-> banking.caddy 'A-record → public IP'

  operator -[deploy]-> argocd 'applies Applications'

  infraRepo -[provisions]-> banking 'Terraform EC2 + Ansible K8s'
  infraRepo -[deploy]-> argocd 'installs ArgoCD + applies Application'
}
