model {

  // ═══════════════════════════════════════════════════
  //  ACTORS
  // ═══════════════════════════════════════════════════

  customer = person 'Customer' {
    description 'End user. Opens the app, logs in, checks balance, sends money, receives real-time WebSocket notifications.'
  }

  operator = person 'Platform Engineer' {
    description 'Runs `make all` from laptop. Terraform provisions EC2, Ansible bootstraps K8s, ArgoCD deploys app, Terraform locks down. Accesses cluster exclusively via Warpgate SSH on :2222 post-lockdown.'
  }

}
