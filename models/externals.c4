model {

  // ═══════════════════════════════════════════════════
  //  EXTERNAL SYSTEMS
  // ═══════════════════════════════════════════════════

  github = externalSystem 'GitHub' {
    technology 'SaaS'
    description 'Hosts source repos. GitHub Actions CI: matrix build → GHCR push → yq tag bump in gitops repo. DevSecOps on PRs: Trivy, Gitleaks, CodeQL, Bandit, pip-audit.'
    style { icon tech:github }
  }

  ghcr = externalSystem 'GHCR' {
    technology 'OCI Registry'
    description 'GitHub Container Registry. Multi-arch Docker images tagged with git SHA (7-char).'
    style { icon tech:docker }
  }

  duckdns = externalSystem 'DuckDNS' {
    technology 'Dynamic DNS'
    description 'systemd service on master node. Polls public IP via IMDSv2, updates A-record on change. Enables Let\'s Encrypt TLS without static IP or ELB.'
    style { icon https://www.duckdns.org/img/ducky_icon_small.png }
  }

  letsencrypt = externalSystem 'Let\'s Encrypt' {
    technology 'ACME'
    description 'HTTP-01 challenge on port 80. Caddy auto-obtains wildcard cert. Zero-cost TLS.'
  }

  instana = externalSystem 'Instana' {
    technology 'APM · OTel Backend'
    description 'Production APM. Host agent (DaemonSet) on :4317 collects OTLP/gRPC traces. Auto-discovers PostgreSQL, Redis, Kong, Nginx. Go Collector instruments pgxpool + go-redis.'
    style { icon https://avatars.githubusercontent.com/u/5128994?s=200&v=4 }
  }

  infra_repo = externalSystem 'bankind-demo-infra' {
    technology 'Terraform · Ansible'
    description '''
Terraform: 4 EC2 spot instances + phased Security Group → inventory.ini.
Ansible site.yml (9 plays): OS hardening → containerd → kubeadm → Cilium → ArgoCD → deploy → Warpgate seed → lockdown → kubeconfig.
'''
    style { icon tech:terraform }
  }

}
