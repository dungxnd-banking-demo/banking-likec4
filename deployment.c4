deployment {

  aws = cloud 'AWS' {
    title 'AWS ap-southeast-1'

    vpc = vpc 'Default VPC' {
      description 'Default VPC with public subnet. 4 spot EC2 instances with random public IPs.'

      sg = ec2 'Security Group' {
        description 'Phased: provisioning (SSH:22 + kube-api:6443 from admin CIDR). Lockdown (only 80/443/2222 from 0.0.0.0/0).'
        technology 'AWS SG'
      }

      master = ec2 'Master Node' {
        title 'master (t3a.medium)'
        description 'Ubuntu 26.04. K8s control-plane. Caddy deployed via nodeSelector — binds **hostPort 80/443/2222** directly. ArgoCD. Cilium CNI kube-proxy replacement. kube-apiserver audit (CIS policy).'
        technology 'Ubuntu 26.04'
      }

      worker1 = ec2 'Worker Node 1' {
        title 'worker-1 (t3a.medium)'
        description 'Entry + messaging pods: Frontend, Kong, api-producer, NATS.'
        technology 'Ubuntu 26.04'
      }

      worker2 = ec2 'Worker Node 2' {
        title 'worker-2 (t3a.medium)'
        description 'Service + data pods: auth, account, transfer, notification, PostgreSQL, Redis.'
        technology 'Ubuntu 26.04'
      }

      warpgate = ec2 'Warpgate Node' {
        title 'warpgate (t3a.small)'
        description 'Dedicated security node. Taint role=security:NoSchedule. Warpgate SSH proxy + admin UI + K8s proxy. SQLite 10Gi PVC.'
        technology 'Ubuntu 26.04'
      }
    }
  }
}

deployment {
  extend aws.vpc.master {
    caddyInstance = instanceOf banking.caddy {
      title 'Caddy (hostPort 80/443/2222)'
      description 'Deployed on master via nodeSelector. Uses **hostPort 80** (HTTP), **hostPort 443** (HTTPS), and **hostPort 2222** (Warpgate SSH). Traffic hits the node IP directly — no Ingress, no LoadBalancer.'
    }
  }

  extend aws.vpc.worker1 {
    frontendInstance = instanceOf banking.frontend {
      title 'Frontend (nginx:alpine)'
      description 'ngx_otel_module. proxy_pass /api/* & /ws → kong:8000.'
    }
    kongInstance = instanceOf banking.kong {
      title 'Kong :8000 (ClusterIP)'
    }
    producerInstance = instanceOf banking.producer {
      title 'api-producer :8080'
    }
    natsInstance = instanceOf banking.nats {
      title 'NATS + JetStream (1Gi PV)'
    }
  }

  extend aws.vpc.worker2 {
    authInstance = instanceOf banking.auth {
      title 'auth-service :8001'
    }
    accountInstance = instanceOf banking.account {
      title 'account-service :8002'
    }
    transferInstance = instanceOf banking.transfer {
      title 'transfer-service :8003'
    }
    notifyInstance = instanceOf banking.notify {
      title 'notification-service :8004'
    }
    postgresInstance = instanceOf banking.postgres {
      title 'PostgreSQL 18 (5Gi PV)'
    }
    redisInstance = instanceOf banking.redis {
      title 'Redis 8 (1Gi PV)'
    }
  }
}
